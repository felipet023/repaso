NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
# ¡Importante! El esquema bike-store.sql crea la base "bike_store"
DB_NAME=bike_store

# Cambia este valor por una clave segura y larga en producción
JWT_SECRET=cambia-este-valor-por-una-clave-segura
JWT_EXPIRES_IN=2h

# Admin inicial (se crea automáticamente al arrancar si no existe)
ADMIN_NAME=Administrador TUKI
ADMIN_EMAIL=admin@bike-store.local
ADMIN_PASSWORD=AdminDemo2026!

# Cliente de demostración (se crea automáticamente al arrancar si no existe)
DEMO_NAME=Cliente Demo
DEMO_EMAIL=cliente@bike-store.local
DEMO_PASSWORD=ClienteDemo2026!
